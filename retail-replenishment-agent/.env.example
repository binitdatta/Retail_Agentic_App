# --- Spring Boot API ---
API_BASE_URL=http://localhost:8087/api

# --- Keycloak (client_credentials — this agent is the
#     retail-replenishment-agent confidential client's service account) ---
KEYCLOAK_ISSUER=http://localhost:8080/realms/retail-replenishment
KEYCLOAK_CLIENT_ID=retail-replenishment-agent
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_LOCAL_DEV_SECRET

# --- Anthropic (backs both recommend_replenishment and escalate_shortage judgment calls) ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Forecast tuning ---
FORECAST_LOOKBACK_DAYS=14
FORECAST_HORIZON_DAYS=7

# --- Delivery monitoring window (should comfortably exceed the backend's
#     delivery-simulator cadence — see application.yml: app.delivery-simulator.* —
#     so the agent is still watching when DELIVERED events land) ---
MONITOR_DELIVERY_MAX_MINUTES=8
MONITOR_DELIVERY_POLL_SECONDS=30

LOG_LEVEL=INFO